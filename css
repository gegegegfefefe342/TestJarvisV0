/* ============ RESET & BASE ============ */
* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --bg-0: #03060f;         /* sfondo più scuro */
  --bg-1: #060b1a;         /* sfondo pannelli */
  --bg-2: #0b1324;         /* sfondo input */
  --line: #15335c;         /* bordi */
  --cyan: #00d4ff;         /* accento principale */
  --cyan-soft: #4fe3ff;
  --blue: #1f6feb;
  --text: #d8e7ff;
  --text-dim: #6b86a8;
  --ok: #22ff88;
  --danger: #ff4d6d;
}

html, body {
  height: 100%;
  background: var(--bg-0);
  color: var(--text);
  font-family: 'Segoe UI', 'Roboto', system-ui, sans-serif;
  overflow: hidden;
}

/* Griglia luminosa di sfondo */
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image:
    linear-gradient(rgba(0,212,255,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,212,255,.04) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
  z-index: 0;
}

/* ============ APP LAYOUT ============ */
#app {
  position: relative;
  z-index: 1;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ============ TOPBAR ============ */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 24px;
  border-bottom: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(0,212,255,.05), transparent);
}

.brand { display: flex; align-items: center; gap: 14px; }

.logo {
  width: 42px; height: 42px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--cyan) 20%, transparent 70%);
  box-shadow: 0 0 20px var(--cyan), inset 0 0 10px var(--cyan);
  animation: pulse-logo 2.5s ease-in-out infinite;
}

@keyframes pulse-logo {
  0%,100% { transform: scale(1);   box-shadow: 0 0 16px var(--cyan); }
  50%     { transform: scale(1.1); box-shadow: 0 0 32px var(--cyan); }
}

.brand h1 {
  font-size: 20px;
  letter-spacing: 4px;
  color: var(--cyan);
  text-shadow: 0 0 10px rgba(0,212,255,.6);
}

.subtitle {
  font-size: 11px;
  color: var(--text-dim);
  letter-spacing: 2px;
  text-transform: uppercase;
}

.clock { text-align: right; }

#clock-time {
  font-size: 22px;
  font-family: 'Consolas', monospace;
  color: var(--cyan-soft);
  letter-spacing: 3px;
  text-shadow: 0 0 8px rgba(0,212,255,.5);
}

#clock-date {
  font-size: 11px;
  color: var(--text-dim);
  letter-spacing: 2px;
  text-transform: uppercase;
}

.icon-btn {
  background: transparent;
  border: 1px solid var(--line);
  color: var(--cyan);
  width: 40px; height: 40px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 18px;
  transition: all .2s;
}
.icon-btn:hover { background: rgba(0,212,255,.1); box-shadow: 0 0 16px rgba(0,212,255,.4); }

/* ============ MAIN GRID ============ */
.main-grid {
  flex: 1;
  display: grid;
  grid-template-columns: 260px 1fr 300px;
  gap: 0;
  overflow: hidden;
}

.main-grid.no-history { grid-template-columns: 260px 1fr 0; }

/* ============ LEFT PANEL ============ */
.left-panel {
  padding: 24px 18px;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22px;
  background: linear-gradient(180deg, rgba(0,212,255,.02), transparent);
}

/* ===== Arc reactor ===== */
.reactor {
  position: relative;
  width: 160px; height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter .3s;
}
.reactor.listening { filter: drop-shadow(0 0 20px var(--cyan)); }

.ring {
  position: absolute;
  border-radius: 50%;
  border: 2px solid transparent;
  border-top-color: var(--cyan);
  border-bottom-color: var(--cyan);
}

.ring-1 { width: 160px; height: 160px; animation: spin 8s linear infinite; }
.ring-2 { width: 118px; height: 118px; animation: spin 5s linear infinite reverse;
          border-top-color: var(--cyan-soft); border-bottom-color: var(--cyan-soft); }
.ring-3 { width: 78px;  height: 78px;  animation: spin 3s linear infinite;
          border-left-color: var(--cyan); border-right-color: var(--cyan); }

.core {
  width: 40px; height: 40px;
  border-radius: 50%;
  background: radial-gradient(circle, #ffffff 20%, var(--cyan) 60%, transparent 100%);
  box-shadow: 0 0 30px var(--cyan), 0 0 60px var(--cyan);
  animation: pulse-core 2s ease-in-out infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse-core {
  0%,100% { transform: scale(1);   opacity: 1; }
  50%     { transform: scale(1.2); opacity: .85; }
}

/* ===== Status panel ===== */
.status-panel {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 12px;
  background: rgba(0,212,255,.02);
}

.status-row {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  letter-spacing: 2px;
  padding: 6px 0;
  color: var(--text-dim);
  border-bottom: 1px dashed rgba(21,51,92,.6);
}
.status-row:last-child { border-bottom: none; }

.status-row span:last-child { color: var(--cyan-soft); }
.status-row .ok { color: var(--ok) !important; }

/* ===== Ghost buttons ===== */
.ghost-btn {
  width: 100%;
  padding: 10px;
  border: 1px solid var(--line);
  background: transparent;
  color: var(--text);
  border-radius: 8px;
  cursor: pointer;
  font-size: 12px;
  letter-spacing: 1px;
  transition: all .2s;
}
.ghost-btn:hover { border-color: var(--cyan); color: var(--cyan); box-shadow: 0 0 12px rgba(0,212,255,.3); }
.ghost-btn.danger:hover { border-color: var(--danger); color: var(--danger); box-shadow: 0 0 12px rgba(255,77,109,.3); }

/* ============ CHAT PANEL ============ */
.chat-panel {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat {
  flex: 1;
  padding: 20px 24px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
  scroll-behavior: smooth;
}

/* Scrollbar */
.chat::-webkit-scrollbar { width: 6px; }
.chat::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }

/* Messaggi */
.msg { display: flex; animation: fade-in .3s ease; }
.msg.user      { justify-content: flex-end; }
.msg.assistant { justify-content: flex-start; }

.bubble {
  max-width: 72%;
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 14px;
  line-height: 1.55;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.msg.user .bubble {
  background: linear-gradient(135deg, #1f6feb, #0b4fa8);
  color: #fff;
  border-bottom-right-radius: 3px;
  box-shadow: 0 0 12px rgba(31,111,235,.4);
}

.msg.assistant .bubble {
  background: rgba(0,212,255,.05);
  border: 1px solid var(--line);
  color: var(--text);
  border-bottom-left-radius: 3px;
  box-shadow: 0 0 8px rgba(0,212,255,.15);
}

.msg.assistant .bubble::before {
  content: 'JARVIS · ';
  color: var(--cyan);
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 1px;
}

/* Animazione di comparsa */
@keyframes fade-in {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Pallino "sto pensando" */
.typing .bubble { color: var(--text-dim); font-style: italic; }
.typing .bubble::after {
  content: '...';
  animation: dots 1.4s steps(4, end) infinite;
  display: inline-block; width: 12px; overflow: hidden; vertical-align: bottom;
}
@keyframes dots { from { width: 0; } to { width: 14px; } }

/* ============ CHAT FORM ============ */
.chat-form {
  display: flex;
  gap: 10px;
  padding: 14px 20px;
  border-top: 1px solid var(--line);
  background: rgba(0,212,255,.02);
}

.chat-form input[type="text"] {
  flex: 1;
  padding: 12px 16px;
  background: var(--bg-2);
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--text);
  font-size: 14px;
  outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.chat-form input[type="text"]:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 12px rgba(0,212,255,.25);
}

.mic-btn, .send-btn {
  width: 46px; height: 46px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: var(--bg-2);
  color: var(--cyan);
  font-size: 18px;
  cursor: pointer;
  transition: all .2s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mic-btn:hover, .send-btn:hover {
  border-color: var(--cyan);
  box-shadow: 0 0 16px rgba(0,212,255,.4);
}
.mic-btn.listening {
  background: var(--cyan);
  color: #03060f;
  animation: pulse-mic 1s ease-in-out infinite;
}
@keyframes pulse-mic {
  0%,100% { box-shadow: 0 0 0 0 rgba(0,212,255,.6); }
  50%     { box-shadow: 0 0 0 14px rgba(0,212,255,0); }
}

/* ============ HISTORY PANEL ============ */
.history-panel {
  border-left: 1px solid var(--line);
  padding: 20px;
  overflow-y: auto;
  background: rgba(0,212,255,.02);
  transition: width .3s;
}
.history-panel.hidden { display: none; }

.history-panel h2 {
  font-size: 13px;
  letter-spacing: 3px;
  color: var(--cyan);
  margin-bottom: 14px;
  text-transform: uppercase;
}

.history-item {
  padding: 10px 12px;
  margin-bottom: 8px;
  border: 1px solid var(--line);
  border-radius: 8px;
  font-size: 12px;
  color: var(--text-dim);
  cursor: default;
  transition: all .2s;
}
.history-item:hover { border-color: var(--cyan); color: var(--text); }
.history-item .h-role { color: var(--cyan-soft); font-weight: 600; letter-spacing: 1px; }

/* ============ MODAL ============ */
.modal {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.7);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal.hidden { display: none; }

.modal-content {
  width: 440px;
  max-width: calc(100vw - 40px);
  background: var(--bg-1);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 26px;
  box-shadow: 0 0 40px rgba(0,212,255,.2);
  animation: fade-in .25s ease;
}
.modal-content h2 {
  color: var(--cyan);
  font-size: 16px;
  letter-spacing: 3px;
  margin-bottom: 20px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
}
.field span { font-size: 12px; color: var(--text-dim); letter-spacing: 1px; }
.field input, .field select {
  padding: 10px 12px;
  background: var(--bg-2);
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--text);
  outline: none;
  font-size: 13px;
}
.field input:focus, .field select:focus { border-color: var(--cyan); }
.field.checkbox { flex-direction: row; align-items: center; gap: 10px; }
.field.checkbox input { width: auto; }

.hint {
  font-size: 11px;
  color: var(--text-dim);
  margin: 12px 0;
  line-height: 1.5;
}

.modal-actions { text-align: right; margin-top: 18px; }
.modal-actions .ghost-btn { width: auto; padding: 10px 20px; }

/* ============ RESPONSIVE ============ */
@media (max-width: 900px) {
  .main-grid { grid-template-columns: 1fr; }
  .left-panel { display: none; }
  .history-panel { position: absolute; right: 0; top: 0; bottom: 0; width: 80%; z-index: 50; background: var(--bg-1); }
}
